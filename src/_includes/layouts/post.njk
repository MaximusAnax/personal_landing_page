---
layout: layouts/base.njk
bodyClass: page page-post
---
<article class="wrap post">
  <a class="back" href="/blog/">← All writing</a>
  <header class="post-header">
    {% if date %}<p class="eyebrow"><time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time></p>{% endif %}
    <h1>{{ title }}</h1>
    {% if description %}<p class="post-dek">{{ description | nl2br | safe }}</p>{% endif %}
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
</article>
