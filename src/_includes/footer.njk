{% from "icons.njk" import icon %}
<footer class="site-footer" id="contact">
  <div class="wrap">
    <p class="eyebrow">Contact</p>
    <h2 class="footer-cta">Building something with agents? <a href="mailto:{{ site.email }}">Let's talk.</a></h2>
    <ul class="footer-links">
      <li><a href="mailto:{{ site.email }}">{{ icon("mail") }}<span>{{ site.email }}</span></a></li>
      <li><a href="{{ site.github }}">{{ icon("github") }}<span>GitHub</span></a></li>
      <li><a href="{{ site.linkedin }}">{{ icon("linkedin") }}<span>LinkedIn</span></a></li>
      <li><a href="{{ site.instagram }}">{{ icon("instagram") }}<span>Instagram</span></a></li>
      <li><a href="{{ site.resume }}">{{ icon("file") }}<span>Resume (PDF)</span></a></li>
    </ul>
    <p class="footer-meta">© {{ build.year }} {{ site.name }} · {{ site.location }} · Built with Eleventy, no framework.</p>
  </div>
</footer>
