---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in collections.all %}
{%- if item.url and not item.data.eleventyExcludeFromCollections and item.url != "/404.html" %}
  <url><loc>{{ site.url }}{{ item.url }}</loc><lastmod>{{ build.iso | truncate(10, true, "") }}</lastmod></url>
{%- endif %}
{%- endfor %}
</urlset>
