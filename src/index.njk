---
layout: layouts/base.njk
permalink: /
bodyClass: page page-home
---
{% from "icons.njk" import icon %}

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero-text">
    <p class="eyebrow">Carnegie Mellon · CS + AI · Class of '27</p>
    <h1 id="hero-title">Abdoul<br />Ndiongue</h1>
    <p class="lede">I build AI agents and the systems around them: the memory, evals and guardrails that make them dependable.</p>
    <p class="hero-sub">
      I research computer-use agents at CMU's Machine Learning Department and build my own agent systems on the side.
      Previously a software engineer intern at Microsoft (Xbox). I grew up in the Bronx.
    </p>
    <div class="cta-row">
      <a class="btn btn-primary" href="#work">See the work {{ icon("down", 16) }}</a>
      <a class="btn" href="{{ site.resume }}">{{ icon("file", 16) }} Resume</a>
      <a class="btn" href="{{ site.github }}">{{ icon("github", 16) }} GitHub</a>
      <a class="btn" href="mailto:{{ site.email }}">{{ icon("mail", 16) }} Email</a>
    </div>
  </div>
  <figure class="portrait">
    <img src="/assets/img/portrait.jpg" width="598" height="820" alt="Abdoul in sunglasses holding a baby goat on a sunny day at Carnegie Mellon" fetchpriority="high" />
  </figure>
  <div class="now" aria-label="What I'm doing now">
    <p class="now-label"><span class="pulse" aria-hidden="true"></span>Now</p>
    <ul>
      <li>Researching why computer-use agents fail, with Prof. Matt Gormley</li>
      <li>Building Orbit v2, an agent-native relationship memory</li>
      <li>President of CMU's Interfraternity Council</li>
    </ul>
  </div>
</section>

<section class="section wrap" id="work" aria-labelledby="work-title">
  <header class="sec-head">
    <span class="sec-num">01</span>
    <h2 id="work-title">Selected work</h2>
    <p>Agent systems first. For each project: what it does, how it's built, and how you can check it.</p>
  </header>

  <nav class="work-index" aria-label="Jump to a project">
    {% for p in projects %}<a href="#{{ p.id }}">{{ p.title }}</a>{% endfor %}
  </nav>

  <div class="work-list">
    {% for p in projects %}
    <article class="work" id="{{ p.id }}">
      <div class="work-meta">
        <p class="work-kind">{{ p.kind }}</p>
        <p class="work-years">{{ p.years }}</p>
        {% if p.status %}<p class="badge">{{ p.status }}</p>{% endif %}
      </div>
      <div class="work-body">
        <h3>{{ p.title }}</h3>
        <p class="work-tagline">{{ p.tagline }}</p>
        <p>{{ p.summary }}</p>

        {% if p.versions %}
        <ol class="versions swipe" data-swipe aria-label="Orbit versions">
          {% for v in p.versions %}
          <li>
            <p class="v-tag">{{ v.tag }} · {{ v.name }}</p>
            <p>{{ v.text }}</p>
            <p class="v-links">
              {% for l in v.links %}<a href="{{ l.href }}">{{ l.label }} {{ icon("arrow", 13) }}</a>{% endfor %}
              {% if v.note %}<span class="muted">{{ v.note }}</span>{% endif %}
            </p>
          </li>
          {% endfor %}
        </ol>
        <div class="swipe-dots" aria-hidden="true"></div>
        {% endif %}

        {% if p.points and p.points.length == 1 %}
        <ul class="points">
          <li>{{ p.points[0] }}</li>
        </ul>
        {% elif p.points and p.points.length %}
        <details class="work-details" open>
          <summary>How it works <span class="count">{{ p.points.length }}</span></summary>
          <ul class="points">
            {% for pt in p.points %}<li>{{ pt }}</li>{% endfor %}
          </ul>
        </details>
        {% endif %}

        <ul class="chips" aria-label="Stack">
          {% for s in p.stack %}<li>{{ s }}</li>{% endfor %}
        </ul>

        {% if (p.links and p.links.length) or p.note %}
        <p class="work-links">
          {% for l in p.links %}<a href="{{ l.href }}">{{ l.label }} {{ icon("arrow", 14) }}</a>{% endfor %}
          {% if p.note %}<span class="muted">{{ p.note }}</span>{% endif %}
        </p>
        {% endif %}
      </div>
    </article>
    {% endfor %}
  </div>
</section>

<section class="section wrap" id="lab" aria-labelledby="lab-title">
  <header class="sec-head">
    <span class="sec-num">02</span>
    <h2 id="lab-title">The lab</h2>
    <p>{{ lab.intro }}</p>
  </header>
  <p class="swipe-hint" aria-hidden="true">Swipe <span>→</span></p>
  <div class="lab-grid swipe" data-swipe aria-label="Personal agent systems">
    {% for item in lab.items %}
    <article class="lab-card">
      <h3>{{ item.name }}</h3>
      <p>{{ item.text }}</p>
      <ul class="chips chips-sm">{% for t in item.tags %}<li>{{ t }}</li>{% endfor %}</ul>
    </article>
    {% endfor %}
  </div>
  <div class="swipe-dots" aria-hidden="true"></div>
  <div class="more-builds">
    <p class="eyebrow">Also on GitHub</p>
    <ul>
      {% for m in lab.more %}
      <li><a href="{{ m.href }}">{{ m.name }} {{ icon("arrow", 13) }}</a><span>{{ m.text }}</span></li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="section wrap" id="experience" aria-labelledby="exp-title">
  <header class="sec-head">
    <span class="sec-num">03</span>
    <h2 id="exp-title">Experience</h2>
  </header>
  <ol class="timeline">
    {% for r in experience.roles %}
    <li>
      <p class="t-when">{{ r.when }}</p>
      <div>
        <h3>{{ r.role }}</h3>
        <p class="t-org">{{ r.org }}</p>
        <p>{{ r.text }}</p>
      </div>
    </li>
    {% endfor %}
  </ol>

  <div class="exp-grid">
    <div class="exp-card">
      <p class="eyebrow">Education</p>
      <h3>{{ experience.education.school }}</h3>
      <p>{{ experience.education.degree }} · {{ experience.education.when }}</p>
      <p class="muted">{{ experience.education.courses }}</p>
      <p class="muted">{{ experience.education.honors }}</p>
    </div>
    <div class="exp-card">
      <p class="eyebrow">Leadership</p>
      <ul class="lead-list">
        {% for l in experience.leadership %}
        <li><span>{{ l.role }}, {{ l.org }}</span><span class="muted">{{ l.when }}</span></li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

<section class="section wrap" id="writing" aria-labelledby="writing-title">
  <header class="sec-head">
    <span class="sec-num">04</span>
    <h2 id="writing-title">Writing &amp; news</h2>
  </header>
  <div class="split">
    <div>
      <p class="eyebrow">Writing</p>
      <ul class="post-list">
        {% for post in collections.posts | limit(3) %}
        <li>
          <a href="{{ post.url }}">
            <span class="post-title">{{ post.data.title }}</span>
            <span class="post-date">{{ post.date | readableDate }}</span>
          </a>
        </li>
        {% endfor %}
      </ul>
      <a class="text-link" href="/blog/">All writing →</a>
    </div>
    <div>
      <p class="eyebrow">News</p>
      <ul class="news-list">
        {% for item in news | sortNews | limit(5) %}
        <li>
          <span class="news-date">{{ item.date | newsDate }}</span>
          <span>{% if item.link %}<a href="{{ item.link }}">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}</span>
        </li>
        {% endfor %}
      </ul>
      <a class="text-link" href="/news/">All news →</a>
    </div>
  </div>
</section>

{% if lastfm.nowPlaying or (lastfm.topAlbums and lastfm.topAlbums.length) %}
<section class="section wrap rotation" aria-labelledby="rot-title">
  <header class="sec-head sec-head-inline">
    <span class="sec-num">05</span>
    <h2 id="rot-title">On rotation</h2>
  </header>
  <div class="rotation-row">
    {% if lastfm.nowPlaying %}
    <p class="np">
      <span class="np-label">{% if lastfm.nowPlaying.isLive %}<span class="pulse" aria-hidden="true"></span>Now playing{% else %}Last played{% endif %}</span>
      <span class="np-track">{{ lastfm.nowPlaying.track }}</span>
      <span class="muted">{{ lastfm.nowPlaying.artist }}</span>
    </p>
    {% endif %}
    {% if lastfm.topAlbums and lastfm.topAlbums.length %}
    <ul class="albums" aria-label="Top albums lately">
      {% for a in lastfm.topAlbums %}
      <li><a href="{{ a.url }}" title="{{ a.title }} — {{ a.artist }}"><img src="{{ a.coverUrl }}" alt="{{ a.title }} by {{ a.artist }}" width="72" height="72" loading="lazy" /></a></li>
      {% endfor %}
    </ul>
    {% endif %}
    <a class="text-link" href="{{ lastfm.profileUrl }}">Last.fm →</a>
  </div>
</section>
{% endif %}
