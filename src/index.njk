---
layout: layouts/home.njk
permalink: /
now:
  - label: Researching
    text: Why computer-use agents fail, with Prof. Matt Gormley
  - label: Building
    text: Orbit v2, an agent-native relationship memory
  - label: Leading
    text: CMU's Interfraternity Council
consoleLines:
  - Researching why computer-use agents fail.
  - Building Orbit v2, an agent-native memory.
  - President of CMU's Interfraternity Council.
  - Building something with agents? Say hi →
---
<header class="head">
  <a class="head__logo" href="#top" aria-label="{{ site.name }}, home"><svg class="logo" viewBox="0 0 44 32"><use href="#mono"/></svg></a>
  <div class="head__console mono" aria-hidden="true"><span id="console" data-msgs="{{ consoleLines | dump }}">{{ consoleLines[0] }}</span></div>
  <a class="head__nav" href="#work">Work</a>
  <a class="head__nav d-only" href="#lab">Lab</a>
  <a class="head__nav d-only" href="#writing">Writing</a>
  <a class="head__nav" href="{{ site.resume }}">Resume</a>
  <a class="head__icon d-only" href="{{ site.github }}" aria-label="GitHub">GH</a>
  <a class="head__icon d-only" href="{{ site.linkedin }}" aria-label="LinkedIn">in</a>
  <a class="head__cta" href="#contact">Say hi</a>
</header>

<main id="main">
  <section class="hero" id="top">
    <div class="hero__waves"><canvas id="waves" aria-hidden="true"></canvas></div>
    <div class="sep sep--info"><b>▶</b><span>Carnegie Mellon · CS + AI · Class of '27</span><i class="grow"></i><span class="code" aria-hidden="true">1011010011010110</span><i></i><span>{{ site.location }}</span><b>◀</b></div>
    <h1 class="hero__title"><span class="word w1">Abdoul</span><svg class="star" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 0c1 10 6 15 16 16-10 1-15 6-16 16-1-10-6-15-16-16C10 15 15 10 16 0z"/></svg><span class="word w2">Ndiongue</span></h1>
    <div class="hero__lede">
      <p>I build AI agents and the systems around them: the memory, evals and guardrails that make them dependable.</p>
      <div class="hero__cta mono"><a class="btn btn--fill" href="#work">See the work ↓</a><a class="btn" href="{{ site.resume }}">Resume</a><a class="btn" href="#contact">Contact</a></div>
    </div>
  </section>

  <section class="about" id="about">
    <div class="about__label mono"><span>About</span><em>Carnegie Mellon · CS + AI · Class of '27</em></div>
    <div class="about__text">
      <p>I research computer-use agents at CMU's Machine Learning Department and build my own agent systems on the side.</p>
      <p>Previously a software engineer intern at Microsoft (Xbox). I grew up in the Bronx.</p>
    </div>
    <dl class="facts">
      {%- for item in now %}
      <div><dt class="mono">{{ item.label }}</dt><dd>{{ item.text }}</dd></div>
      {%- endfor %}
      <div><dt class="mono">Based in</dt><dd>{{ site.location }}</dd></div>
    </dl>
  </section>

  {# The tunnel: cards are real HTML so they exist without JS; home.js only moves them. #}
  <section class="work" id="work" aria-label="Work">
    <div class="work__pin">
      <div class="work__ring"></div>
      <div class="work__mask"><div class="work__scene" id="scene">
        {%- for p in projects %}
        <article class="card"><div class="card__art" aria-hidden="true"><b>{{ loop.index | pad2 }}</b><em>{{ p.status }}</em></div><h3>{{ p.title }}</h3><p class="card__dek">{{ p.tagline }}</p><p class="mono"><span>{{ p.kind }}</span><span>#an-00{{ loop.index | pad2 }}/{{ projects.length | pad2 }}</span></p></article>
        {%- endfor %}
      </div></div>
      <p class="work__hint mono"><span>Keep scrolling</span></p>
      <a class="work__skip mono" href="#index">Skip to the list ↓</a>
    </div>
  </section>

  <div class="index" id="index" aria-label="Project index">
    <div class="label mono"><span>Selected work</span><span>What it does, how it's built, how to check it</span></div>
    {%- for p in projects %}
    <details id="{{ p.id }}"{% if loop.first %} open{% endif %}>
      <summary class="rowfx"><span class="mono">{{ loop.index | pad2 }}</span><strong>{{ p.title }}</strong><span class="mono">{{ p.status }}</span></summary>
      <div class="index__body">
        <p>{{ p.tagline }}</p>
        <p>{{ p.summary }}</p>
        {%- if p.points and p.points.length %}
        <ul>{% for point in p.points %}<li>{{ point }}</li>{% endfor %}</ul>
        {%- endif %}
        {%- if p.versions %}
        <div class="ver">
          {%- for v in p.versions %}
          <p><b>{{ v.tag }} · {{ v.name }}</b>{{ v.text }}{% for l in v.links %} <a href="{{ l.href }}">{{ l.label }} →</a>{% endfor %}{% if v.note %} <span class="mono">{{ v.note }}</span>{% endif %}</p>
          {%- endfor %}
        </div>
        {%- endif %}
        <p class="mono">{{ p.kind }} · {{ p.years }} · {{ p.stack | join(" · ") }}</p>
        {%- if (p.links and p.links.length) or p.note %}
        <p class="mono">{% for l in p.links %}<a href="{{ l.href }}">{{ l.label }} →</a>{% endfor %}{% if p.note %}<span>{{ p.note }}</span>{% endif %}</p>
        {%- endif %}
      </div>
    </details>
    {%- endfor %}
  </div>

  <section class="xp" id="experience">
    <div class="label mono"><span>Experience</span><a href="{{ site.resume }}">Resume (PDF) →</a></div>
    {%- for r in experience.roles %}
    <div class="xp__row rowfx"><span class="mono">{{ r.when }}</span><div><h3>{{ r.role }}</h3><span>{{ r.org }}</span></div><p>{{ r.text }}</p></div>
    {%- endfor %}
    <div class="xp__cols">
      <div><h3 class="mono">Education</h3><ul><li><span>{{ experience.education.school }}</span><span class="mono">{{ experience.education.when }}</span></li><li>{{ experience.education.degree }}</li><li>{{ experience.education.honors }}</li></ul></div>
      <div><h3 class="mono">Leadership</h3><ul>{% for l in experience.leadership %}<li><span>{{ l.role }}, {{ l.org }}</span><span class="mono">{{ l.when }}</span></li>{% endfor %}</ul></div>
    </div>
  </section>

  <section class="lab" id="lab">
    <div class="lab__head">
      <h2>The Lab</h2>
      <p>{{ lab.intro }} <span class="mono">Drag →</span></p>
    </div>
    <div class="lab__rail" tabindex="0" aria-label="Lab systems, scroll sideways">
      {%- for item in lab.items %}
      <article class="rig">
        <div class="rig__screen" aria-hidden="true">
          {%- if item.visual == "captions" %}<div class="v-cap"><span>Every</span><span>word</span><span>lands</span><span>on</span><span>time</span></div>
          {%- elif item.visual == "radar" %}<div class="v-radar"></div>
          {%- elif item.visual == "pulse" %}<svg class="v-pulse" viewBox="0 0 200 60"><path pathLength="1" d="M0 32h38l8-20 10 38 8-28 6 10h42l8-20 10 38 8-28 6 10h56"/></svg>
          {%- elif item.visual == "grade" %}<div class="v-grade"><i></i><span class="mono"><b>Floor</b><b>Now</b><b>Ceiling</b></span></div>
          {%- else %}<span class="mono">{{ item.name }}</span>
          {%- endif %}
        </div>
        <h3>{{ item.name }}</h3><p>{{ item.text }}</p><span class="mono">{{ item.tags | join(" · ") }}</span>
      </article>
      {%- endfor %}
    </div>
    <div class="lab__more">
      {%- for item in lab.more %}
      <a href="{{ item.href }}"><strong>{{ item.name }}</strong><span>{{ item.text }}</span></a>
      {%- endfor %}
    </div>
  </section>

  <section class="wn" id="writing">
    <div class="wn__writing">
      <div class="label mono"><span>Writing</span><span>Notes on building and learning</span></div>
      {%- for post in collections.posts | limit(3) %}
      <a class="post rowfx" href="{{ post.url }}" aria-label="{{ post.data.title }}"><span class="mono">{{ post.date | readableDate }}</span><strong data-scramble>{{ post.data.title }}</strong>{% if post.data.description %}<p>{{ post.data.description | firstLine }}</p>{% endif %}</a>
      {%- endfor %}
      <a class="more mono" href="/blog/">All writing →</a>
    </div>
    <div class="wn__news">
      <div class="label mono"><span>News</span><span>Newest first</span></div>
      <ul class="news">
        {%- for item in news | sortNews | limit(5) %}
        <li><span class="mono">{{ item.date | newsDate }}</span><span>{{ item.title }}</span></li>
        {%- endfor %}
      </ul>
      <a class="more mono" href="/news/">All news →</a>
    </div>
  </section>

  {# Milestones fly out of the smiley; tiles are the ten newest news items. #}
  <section class="way" id="way" aria-label="Shipping things since 2023">
    <svg class="way__rays" aria-hidden="true"><path/></svg>
    <div class="way__face" aria-hidden="true"><svg viewBox="0 0 90 90"><g class="eyes" fill="var(--ink)"><ellipse cx="33" cy="38" rx="5" ry="8"/><ellipse cx="57" cy="38" rx="5" ry="8"/></g><path d="M27 56c6 9 30 9 36 0" fill="none" stroke="var(--ink)" stroke-width="3" stroke-linecap="round"/></svg></div>
    <div class="way__objs" id="objs" aria-hidden="true">
      {%- for item in news | sortNews | limit(10) %}
      <div class="obj"><span>{{ item.date | newsDate }}</span><b>{{ item.short or item.title }}</b></div>
      {%- endfor %}
    </div>
    <h2 class="way__text"><span>Shipping</span><span>Things</span><span>Since</span><span>2023</span></h2>
    <p class="way__hint mono">Grab a milestone, let it go</p>
  </section>

  <section class="cta" id="contact">
    <canvas id="grid" aria-hidden="true"></canvas>
    <p class="cta__q"><span>Building something with agents?</span></p>
    <div class="cta__hover">
      <button class="cta__disc" type="button" id="go" aria-expanded="false" aria-label="Open contact"><span class="cta__go" aria-hidden="true">GO</span></button>
      <div class="cta__big">
        <strong>Let's<br>Talk</strong>
        <div class="cta__mail"><code id="mail">{{ site.email }}</code><button type="button" id="copy">Copy</button></div>
      </div>
    </div>
    <div class="cta__links mono">
      <button type="button" data-copy="{{ site.email }}">{{ site.email }} · Copy</button>
      <a href="mailto:{{ site.email }}">Email</a>
      <a href="{{ site.github }}">GitHub</a>
      <a href="{{ site.linkedin }}">LinkedIn</a>
      <a href="{{ site.instagram }}">Instagram</a>
      <a href="{{ site.resume }}">Resume (PDF)</a>
      <a href="/abdoul-ndiongue.vcf">Save contact</a>
      <button type="button" class="share-btn" data-share-title="{{ site.name }}" data-share-text="{{ site.name }}: AI agents and the systems around them" data-share-url="{{ site.url }}">Share</button>
    </div>
  </section>
</main>

<footer class="foot">
  <svg class="logo" viewBox="0 0 44 32" aria-hidden="true"><use href="#mono"/></svg>
  {%- if lastfm.nowPlaying %}
  <a class="foot__rot mono" href="{{ lastfm.profileUrl }}"><svg class="disc" viewBox="0 0 92 92" aria-hidden="true"><circle cx="46" cy="46" r="46" fill="var(--ink)"/><g fill="none" stroke="var(--paper)" stroke-width=".6" opacity=".55"><circle cx="46" cy="46" r="40"/><circle cx="46" cy="46" r="33"/><circle cx="46" cy="46" r="26"/></g><circle cx="46" cy="46" r="15" fill="var(--paper)"/><path d="M46 33v8" stroke="var(--ink)" stroke-width="3"/><circle cx="46" cy="46" r="2.5" fill="var(--ink)"/></svg><span>On rotation: {{ lastfm.nowPlaying.track }} · {{ lastfm.nowPlaying.artist }}</span></a>
  {%- endif %}
  <span class="mono">© {{ build.year }} {{ site.name }} · {{ site.location }}</span>
</footer>
