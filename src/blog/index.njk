---
layout: layouts/base.njk
title: Writing
description: Notes on building, learning, and engineering by Abdoul Ndiongue.
permalink: /blog/
---
<section class="page-intro">
  <p class="mono">Writing</p>
  <h1>Notes on building and learning.</h1>
</section>
<section class="page-wrap">
  <ul class="page-list">
    {% for post in collections.posts %}
    <li>
      <a class="next" href="{{ post.url }}">
        <span class="mono">{{ post.date | readableDate }}</span>
        <strong>{{ post.data.title }}</strong>
        {% if post.data.description %}<p>{{ post.data.description | nl2br | safe }}</p>{% endif %}
      </a>
    </li>
    {% else %}
    <li><p>No posts yet.</p></li>
    {% endfor %}
  </ul>
</section>
