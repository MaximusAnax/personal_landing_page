---
layout: layouts/base.njk
title: News
description: Milestones and updates from Abdoul Ndiongue.
permalink: /news/
---
<section class="wrap page-intro">
  <p class="eyebrow">News</p>
  <h1>Milestones, newest first.</h1>
</section>
<section class="wrap">
  <ol class="news-full">
    {% for item in news | sortNews %}
    <li>
      <span class="news-date">{{ item.date | newsDate }}</span>
      <div>
        <p class="news-title">{% if item.link %}<a href="{{ item.link }}">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}</p>
        {% if item.text %}<p class="muted">{{ item.text | safe }}</p>{% endif %}
      </div>
    </li>
    {% endfor %}
  </ol>
</section>
